{
  "expo": {
    "name": "Baneh360",
    "slug": "baneh360",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "baneh360",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baneh360.app"
    },
    "android": {
      "package": "com.baneh360.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4FAFB"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
